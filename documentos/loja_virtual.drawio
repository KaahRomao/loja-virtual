        <mxCell id="fk-endereco.id_estado" value="" style="edgeStyle=none;rounded=1;arcSize=8;html=1;strokeWidth=1.6;strokeColor=#8C5418;endArrow=blockThin;endFill=1;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="col-endereco.id_estado" target="col-estado.id">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1095" y="580" />
              <mxPoint x="1095" y="207" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="chaves" value="&lt;b&gt;PK&lt;/b&gt; · chave primária &amp;nbsp;&amp;nbsp; &lt;b&gt;FK&lt;/b&gt; · chave estrangeira &amp;nbsp;&amp;nbsp; &lt;b&gt;?&lt;/b&gt; · aceita NULL &amp;nbsp;&amp;nbsp; &lt;b style='color:#8C5418'&gt;Cabeçalho âmbar&lt;/b&gt; · tabela de apoio ou técnica&lt;br&gt;As setas verdes ligam compras e clientes. Roxo identifica as referências às situações. Consulte o dicionário para padrões, restrições e chaves compostas." style="rounded=1;arcSize=12;absoluteArcSize=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=14;fillColor=#F5FAF8;strokeColor=#B8D5CD;fontFamily=Helvetica;fontColor=#153C35;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="50" y="970" width="1342" height="62" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="Modelo Físico" id="vora-modelo-fisico">
    <mxGraphModel dx="1194" dy="790" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1320" pageHeight="886" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="masthead" value="" style="rounded=0;fillColor=#034D45;strokeColor=none;locked=1;" vertex="1" parent="1">
          <mxGeometry x="0" y="0" width="1320" height="94" as="geometry" />
        </mxCell>
        <mxCell id="titulo" value="VORA  /  MODELO FÍSICO" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;spacing=0;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=30;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="44" y="15" width="1232" height="37" as="geometry" />
        </mxCell>
        <mxCell id="subtitulo" value="SQLite em arquivo no desenvolvimento e libSQL no Turso para a API publicada no Render" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;spacing=0;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=16;fontColor=#E0F6EE;" vertex="1" parent="1">
          <mxGeometry x="44" y="55" width="1232" height="25" as="geometry" />
        </mxCell>
        <mxCell id="dados" value="&lt;b style='font-size:20px'&gt;1. Criação e dados iniciais&lt;/b&gt;&lt;br&gt;&lt;br&gt;create.sql cria as tabelas e restrições. insert.sql insere situações, categorias, estados e o catálogo inicial. A inicialização completa colunas e índices de esquemas anteriores. A tabela migracao registra a aplicação de ofertas-iniciais." style="rounded=1;arcSize=12;absoluteArcSize=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=17;fillColor=#F5FAF8;strokeColor=#B8D5CD;fontFamily=Helvetica;fontColor=#153C35;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="42" y="122" width="600" height="157" as="geometry" />
        </mxCell>
        <mxCell id="dinheiro" value="&lt;b style='font-size:20px'&gt;2. Tipos e convenções&lt;/b&gt;&lt;br&gt;&lt;br&gt;INTEGER guarda preços, frete, quantidades e IDs. Valores monetários estão em centavos. TEXT guarda CEPs, datas e valores de integração. Datas do SQL novo usam DATETIME('now'). A API registra datas de pagamento em UTC." style="rounded=1;arcSize=12;absoluteArcSize=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=17;fillColor=#F5FAF8;strokeColor=#B8D5CD;fontFamily=Helvetica;fontColor=#153C35;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="678" y="122" width="600" height="157" as="geometry" />
        </mxCell>
        <mxCell id="indices" value="&lt;b style='font-size:20px'&gt;3. Unicidade da compra&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;pedido_checkout&lt;/b&gt; · UNIQUE (id_cliente, chave_checkout)&lt;br&gt;&lt;b&gt;pedido_referencia&lt;/b&gt; · UNIQUE (referencia_pagamento)&lt;br&gt;&lt;b&gt;pagamento.id_transacao_externa&lt;/b&gt; · UNIQUE por transação&lt;br&gt;As tabelas de itens também impedem repetir o produto no mesmo pedido ou carrinho." style="rounded=1;arcSize=12;absoluteArcSize=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=17;fillColor=#F5FAF8;strokeColor=#B8D5CD;fontFamily=Helvetica;fontColor=#153C35;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="42" y="305" width="600" height="180" as="geometry" />
        </mxCell>
        <mxCell id="triggers" value="&lt;b style='font-size:20px'&gt;4. Triggers de consistência&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;trg_produto_pedido_baixa_estoque&lt;/b&gt; · baixa por item inserido&lt;br&gt;&lt;b&gt;trg_produto_carrinho_ai / au / ad&lt;/b&gt; · atualizam o horário do carrinho após inserir, atualizar ou excluir um item.&lt;br&gt;O serviço repõe o saldo ao cancelar um pedido elegível." style="rounded=1;arcSize=12;absoluteArcSize=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=17;fillColor=#F5FAF8;strokeColor=#B8D5CD;fontFamily=Helvetica;fontColor=#153C35;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="678" y="305" width="600" height="180" as="geometry" />
        </mxCell>
        <mxCell id="local" value="&lt;b style='font-size:20px'&gt;5. Ambiente local&lt;/b&gt;&lt;br&gt;&lt;br&gt;back-end/data/vora.sqlite é o caminho padrão. SQLite abre com verificação de chaves estrangeiras. O checkout grava pedido e itens em uma transação. Para testes, use um caminho DB_PATH separado." style="rounded=1;arcSize=12;absoluteArcSize=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=17;fillColor=#F5FAF8;strokeColor=#B8D5CD;fontFamily=Helvetica;fontColor=#153C35;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="42" y="511" width="600" height="151" as="geometry" />
        </mxCell>
        <mxCell id="turso" value="&lt;b style='font-size:20px'&gt;6. Banco em uso na nuvem&lt;/b&gt;&lt;br&gt;&lt;br&gt;O banco existente preserva a ordem de colunas migradas, alguns DEFAULTs e os triggers do carrinho com localtime. preco_anterior foi incluído sem CHECK no Turso. A validação de oferta em ambas as bases está na API." style="rounded=1;arcSize=12;absoluteArcSize=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=17;fillColor=#F5FAF8;strokeColor=#B8D5CD;fontFamily=Helvetica;fontColor=#153C35;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="678" y="511" width="600" height="151" as="geometry" />
        </mxCell>
        <mxCell id="arquivos" value="&lt;b&gt;Fontes no repositório&lt;/b&gt;&lt;br&gt;back-end/src/database/sql/create.sql · insert.sql · ofertas-iniciais.sql&lt;br&gt;back-end/src/database/connection.js · documentos/lojaVirtual_dicionario.xlsx" style="rounded=1;arcSize=12;absoluteArcSize=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=17;fillColor=#E6F5EF;strokeColor=#B8D5CD;fontFamily=Helvetica;fontColor=#153C35;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="42" y="696" width="1236" height="112" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>